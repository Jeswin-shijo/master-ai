# Copy to .env. Defaults match infra/docker/docker-compose.yml.
NODE_ENV=development
PORT=3000

# Owner role: migrations only. The app connects as onehuman_app so row-level security applies.
DATABASE_URL=postgres://onehuman:onehuman@localhost:5432/onehuman
APP_DATABASE_URL=postgres://onehuman_app:onehuman_app@localhost:5432/onehuman

# At least 32 characters. Signs session tokens.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=onehuman-agents
NATS_URL=nats://localhost:4222

# Industry Pack registry on disk.
PACKS_DIR=../packs

# LLM gateway. Without a key the gateway runs in deterministic offline mode,
# so the whole platform works end to end with no model calls.
ANTHROPIC_API_KEY=
# auto = offline when no key is set | always = never call a model | never = always call (e.g. `ant auth login` profile)
LLM_OFFLINE=auto
LLM_MODEL_FRONTIER=claude-opus-5-5
LLM_MODEL_STANDARD=claude-sonnet-5-5
LLM_MODEL_SMALL=claude-haiku-5-5
USD_INR_RATE=88

CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Real phone calls to staff (Twilio). Leave empty to use the in-app simulator only.
# PUBLIC_URL must reach this API from the internet; in development run `pnpm tunnel`.
PUBLIC_URL=
TWILIO_ACCOUNT_SID=AC5fd4d39c2f996bfe174e30b8db2c806d
TWILIO_AUTH_TOKEN=597d2924ec09c689daef58abacc4ade8
# The Twilio number calls come from, e.g. +14155550123
TWILIO_FROM_NUMBER=
# Text-to-speech voice (Indian English)
TWILIO_VOICE=Polly.Aditi

# Behind a reverse proxy or tunnel, so public rate limits see the real client address: 1, true, or the proxies' addresses.
# TRUST_PROXY=1

# Where the web app lives, for invite links.
WEB_URL=http://localhost:5173
