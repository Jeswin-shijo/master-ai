{
  "name": "@onehuman/agent-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Tool catalog, pack resolution, industry matching and agent helpers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p __tests__/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@onehuman/schemas": "workspace:*",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "yaml": "^2.8.1"
  }
}
