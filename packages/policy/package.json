{
  "name": "@onehuman/policy",
  "version": "0.1.0",
  "private": true,
  "description": "Risk scoring and Cedar policy engine that decides every agent action",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p __tests__/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.13.0",
    "@onehuman/agent-kit": "workspace:*",
    "@onehuman/schemas": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
