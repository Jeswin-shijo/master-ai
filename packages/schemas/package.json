{
  "name": "@onehuman/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas and types for every ONEHUMAN OS app, service and pack",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./plain": {
      "import": {
        "types": "./dist/plain.d.mts",
        "default": "./dist/plain.mjs"
      },
      "require": {
        "types": "./dist/plain.d.ts",
        "default": "./dist/plain.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  },
  "sideEffects": false
}
