{
  "name": "onehuman-os",
  "private": true,
  "description": "ONEHUMAN OS: agent-native business operating system",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev --filter=./packages/* --filter=@onehuman/backend --filter=@onehuman/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @onehuman/backend db:migrate",
    "smoke": "pnpm --filter @onehuman/backend smoke",
    "evals": "pnpm --filter @onehuman/evals test",
    "evals:live": "node evals/src/live.ts",
    "pack:check": "node evals/src/check.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "e2e": "pnpm --filter @onehuman/web e2e",
    "e2e:mobile": "node master-ai-mobile/e2e/run.mts",
    "e2e:sectors": "pnpm --filter @onehuman/backend e2e:sectors"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "prettier": "^3.6.2"
  }
}
